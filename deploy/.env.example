# ==============================================================================
# AV Suite Self-Hosted Production Environment Variables
# Copy this file to .env before starting: cp .env.example .env
# NOTE: .env is ignored by Git to protect secrets and avoid Git history.
# ==============================================================================

# Web Exposure
HOST_PORT=80

# Backend Configuration
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com

# Database (Supabase / PostgreSQL with Session Pooler)
DATABASE_URL=postgresql+asyncpg://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres

# JWT Security (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_production_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Supabase Storage & Services
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Frontend Configuration
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
