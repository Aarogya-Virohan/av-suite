# AV Control Center (super admin console). AV team only.

# Where data comes from: "mock" (in-memory, no backend) or "http" (real
# /api/v1/platform API, from U5/U6). Production builds default to "http".
NEXT_PUBLIC_PLATFORM_API_MODE=mock

# Backend base URL, without /api/v1 (used only in "http" mode).
NEXT_PUBLIC_API_URL=http://localhost:8000
