# AV Control Center (super admin console). AV team only.

# Where data comes from: "mock" (in-memory, no backend) or "http" (real
# /api/v1/platform API).
# - Production builds use "http" when this is unset or has any other value.
#   Mock data in a production build needs an explicit "mock" here, and is then
#   badged "Mock data" on every screen.
# - Development and tests default to "mock".
# - Vercel project av-suite-control-center: set to "http" for the real console.
NEXT_PUBLIC_PLATFORM_API_MODE=mock

# Backend base URL, without /api/v1 (used only in "http" mode). Required in a
# production build: with no value every call fails with a clear message, it
# never falls back to localhost. It is public by nature; never put a secret in
# any NEXT_PUBLIC_ variable (scripts/check-bundle.mjs checks the build).
NEXT_PUBLIC_API_URL=http://localhost:8000
