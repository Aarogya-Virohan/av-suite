# Application Environment Configuration
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Add the deployed Control Center origin to CORS_ORIGINS for production.
TRUSTED_PROXY_IPS=
# Leave empty unless the app receives traffic from a known proxy. If set, list
# its immediate peer IP/CIDR values, comma-separated (for example: 10.0.0.0/8).


# JWT Configuration for Token-Based Authentication
# Generate a fresh, independent 32-byte cryptographic secret with: openssl rand -hex 32
# This placeholder is intentionally invalid; the app will refuse to start until replaced.
JWT_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
PLATFORM_JWT_EXPIRE_MINUTES=480
# Generate a fresh key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This placeholder is intentionally invalid; never use an example key in deployment.
PLATFORM_MFA_KEY=GENERATE_WITH_Fernet_generate_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Database Configuration - Supabase Session Pooler for IPv4 Support
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-ID]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[PROJECT-ID].supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
